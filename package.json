{
  "name": "trusttrace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "node scripts/sync-env.js && corepack pnpm --filter @trusttrace/api --filter @trusttrace/web --parallel dev",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "corepack pnpm -r --if-present lint",
    "sync-env": "node scripts/sync-env.js",
    "db:generate": "node scripts/sync-env.js && corepack pnpm --filter @trusttrace/database prisma:generate",
    "db:migrate": "node scripts/sync-env.js && corepack pnpm --filter @trusttrace/database prisma:migrate",
    "db:deploy": "node scripts/sync-env.js && corepack pnpm --filter @trusttrace/database prisma:deploy",
    "db:push": "node scripts/sync-env.js && corepack pnpm --filter @trusttrace/database prisma:push",
    "db:seed": "node scripts/sync-env.js && corepack pnpm --filter @trusttrace/database seed",
    "cli": "corepack pnpm --filter @trusttrace/cli dev",
    "tracetrust": "node apps/cli/dist/index.js",
    "trusttrace": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
